# Optional. Only set this for LOCAL development.
#
# Vite inlines every VITE_* variable into the JavaScript bundle at build time,
# so a key set here and then deployed is public to anyone who opens devtools —
# and a free Twelve Data key is 800 requests/day that someone else can spend.
#
# For the deployed app, leave this unset and paste the key into the Charts page
# instead. It is stored in your own browser and never ends up in the bundle.
VITE_TWELVEDATA_API_KEY=

# Optional. Stooq sends no CORS headers, so it cannot be called from a browser
# directly. Point this at a proxy you control to enable keyless EOD backfill.
VITE_STOOQ_PROXY=
